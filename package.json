{
  "name": "agenthub",
  "version": "0.5.10",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:extension": "npm run build -w packages/extension",
    "build:native-host": "npm run build -w packages/native-host",
    "dev": "npm run dev -w packages/extension",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "edge:debug": "node scripts/launch-edge-debug.mjs",
    "test:real-edge": "playwright test --project=real-edge-via-cdp",
    "test:e2e": "playwright test --project=chromium-extension",
    "test:e2e:soak": "playwright test --project=chromium-extension --grep-invert=soak --repeat-each=20",
    "test:e2e:soak:all": "playwright test --project=chromium-extension --repeat-each=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright": "^1.58.2",
    "vitest": "^4.1.2"
  }
}
